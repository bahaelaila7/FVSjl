# Simulation output — FVS writes these next to the keyword file / in the cwd.
*.db
*.sum
*.out
*.tls
*.trl
*.chp
*.sng
*.key.bak

# Julia build artifacts (Manifest.toml IS tracked for reproducibility)
*.so
*.dylib
*.dll
LocalPreferences.toml

# Editor / OS
.DS_Store
*.swp
test/harness/scenarios/*.tre
tmp/
.claude/worktrees/

# stray FFE DSNOUT database (default name, no extension)
__DSNOUT__

# committed reference outputs in examples/ (override the *.sum ignore above)
!examples/**/*.fvsjl.sum
!examples/**/*.fvssn.sum
# committed live-oracle golden sums for the all-species coverage tests
!test/fixtures/**/*.live.sum
# committed self-contained FIA sub-DBs for regression fixtures (e.g. bm_seedling)
!test/fixtures/**/*.db
deps/libfvsmath.*

# durable local FIA sweep coverage DB (survives sessions/container restart; not git-tracked)
data/*.db
data/*.db-wal
data/*.db-shm

# persistent sweep working dir (scratch + redundant master ledger; results are in data/*.db)
.sweep_work/
test/harness/cr/fort.*

# ── session tidy (2026-08-31) ──────────────────────────────────────────────
# scratchpad = per-session working area (oracle dumps, staged Fortran builds, .o).
# The historically-committed files under it stay tracked; new scratch is ignored so it
# does not clutter status or get committed by accident (use `git add -f` to keep one).
scratchpad/
# local .claude hook backups (originals recoverable from git history)
.claude/*.bak
.claude/*-bak
.claude/*.hookbak
.claude/*.stophook-bak
# runtime off-switch signal (moot now the Stop hook is disabled outright)
docs/WESTERN_ROLLOUT_COMPLETE
